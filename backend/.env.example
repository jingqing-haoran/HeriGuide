# SQLite default is fine for the demo. For production use MySQL, e.g.:
# HERIGUIDE_DATABASE_URL=mysql+pymysql://heriguide:your_password@127.0.0.1:3306/heriguide?charset=utf8mb4

# Comma separated list of allowed origins, "*" allows all.
HERIGUIDE_CORS_ORIGINS=*

# Seed the demo dataset when the database is empty.
HERIGUIDE_SEED_DEMO=true

# Third-party services are optional in demo mode and are never required by the front-end.
HERIGUIDE_AMAP_KEY=
HERIGUIDE_TRANSLATION_API_KEY=
HERIGUIDE_TRANSLATION_API_URL=

# Absolute or relative URL prefix used to build full media URLs.
HERIGUIDE_PUBLIC_BASE_URL=http://localhost:5173
